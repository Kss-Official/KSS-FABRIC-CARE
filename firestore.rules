rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID or generated ID)
    // Fields:
    //   - uid: string (Auth UID)
    //   - email: string (User email)
    //   - fullName / displayName: string (User full name)
    //   - role: string ('customer' | 'admin' | 'staff' | 'laundry_staff' | 'delivery_staff' | 'driver')
    //   - phone: string (optional)
    //   - addresses: map (optional, saved addresses)
    //
    // Collection: customers
    // Document ID: {customerId} (e.g. #CUS1001)
    //
    // Collection: orders
    // Document ID: {orderId} (e.g. #LDX10285 or #FC10284)
    //
    // Collection: services
    // Document ID: {serviceId} (e.g. 'wash-fold')
    //
    // Collection: drivers
    // Document ID: {driverId} (e.g. 'drv_1', 'd1')
    //
    // Collection: faqs
    // Document ID: {faqId}
    //
    // Collection: settings
    // Document ID: 'general'
    //
    // Collection: content
    // Document ID: 'terms'
    //
    // Collection: tasks
    // Document ID: {taskId}
    //
    // Collection: notifications
    // Document ID: {notificationId}
    //
    // Collection: support_tickets
    // Document ID: {ticketId}
    //
    // Collection: complaints
    // Document ID: {complaintId}
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' || 
        getUserRole() == 'super_admin' ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*admin.*@.*"))
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() || 
        getUserRole() in ['staff', 'laundry_staff', 'laundry', 'delivery_staff', 'agent', 'delivery', 'delivery_agent', 'driver'] ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches(".*staff.*@.*") ||
          request.auth.token.email.matches(".*laundry.*@.*") ||
          request.auth.token.email.matches(".*driver.*@.*") ||
          request.auth.token.email.matches(".*agent.*@.*") ||
          request.auth.token.email.matches(".*delivery.*@.*") ||
          request.auth.token.email.matches(".*ravi.*@.*")
        ))
      );
    }

    // ===============================================================
    // Collection Access Rules
    // ===============================================================

    // 1. Users Collection (Profile & Role management)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 2. Customers Directory
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 3. Orders Collection (Real-time tracking for customers, staff, and delivery)
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if isAdmin() || isStaff();
    }

    // 4. Services Catalog (Public Read for Landing Page & Booking)
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isAdmin();
    }

    // 5. Drivers Management
    match /drivers/{driverId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isAdmin();
    }

    // 6. FAQs (Public Read for Landing Page)
    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isStaff() || isAdmin();
    }

    // 7. Settings Document
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    // 8. Content (Terms & Conditions, Privacy Policy)
    match /content/{docId} {
      allow read: if true;
      allow write: if isStaff() || isAdmin();
    }

    // 9. Delivery & Pickup Tasks
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 11. Support Tickets
    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }

    // 12. Complaints & Quality Reports
    match /complaints/{complaintId} {
      allow read, write: if true;
    }

    // Default Deny All other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

