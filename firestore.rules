rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID or generated ID)
    // Fields:
    //   - uid: string (Auth UID)
    //   - email: string (User email)
    //   - fullName / displayName: string (User full name)
    //   - role: string ('customer' | 'admin' | 'staff' | 'laundry_staff' | 'delivery_staff' | 'driver')
    //   - phone: string (optional)
    //   - addresses: map (optional, saved addresses)
    //
    // Collection: customers
    // Document ID: {customerId} (e.g. #CUS1001)
    //
    // Collection: orders
    // Document ID: {orderId} (e.g. #LDX10285 or #FC10284)
    //
    // Collection: services
    // Document ID: {serviceId} (e.g. 'wash-fold')
    //
    // Collection: drivers
    // Document ID: {driverId} (e.g. 'drv_1', 'd1')
    //
    // Collection: faqs
    // Document ID: {faqId}
    //
    // Collection: settings
    // Document ID: 'general'
    //
    // Collection: content
    // Document ID: 'terms'
    //
    // Collection: tasks
    // Document ID: {taskId}
    //
    // Collection: notifications
    // Document ID: {notificationId}
    //
    // Collection: support_tickets
    // Document ID: {ticketId}
    //
    // Collection: complaints
    // Document ID: {complaintId}
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' || 
        getUserRole() == 'super_admin' ||
        (request.auth.token.email != null && request.auth.token.email.matches(".*admin.*@.*"))
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() || 
        getUserRole() == 'staff' || 
        getUserRole() == 'laundry_staff' || 
        getUserRole() == 'delivery_staff' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches(".*staff.*@.*") ||
          request.auth.token.email.matches(".*laundry.*@.*") ||
          request.auth.token.email.matches(".*driver.*@.*")
        ))
      );
    }

    // ===============================================================
    // Collection Access Rules
    // ===============================================================

    // 1. Users Collection (Profile & Role isolation)
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == 'customer') || isStaff()
      );
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) || isStaff()
      );
      allow delete: if isAdmin();
    }

    // 2. Customers Directory
    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 3. Orders Collection (Customer & Staff access)
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        !('customerId' in resource.data) ||
        resource.data.customerId == request.auth.uid || 
        resource.data.customerId == 'guest' || 
        isStaff()
      );
      allow create: if true; // Allows customer bookings
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Services Catalog (Public Read for Landing Page & Booking)
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // 5. Drivers Management
    match /drivers/{driverId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // 6. FAQs (Public Read for Landing Page)
    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // 7. Settings Document
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 8. Content (Terms & Conditions, Privacy Policy)
    match /content/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 9. Delivery & Pickup Tasks
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // 11. Support Tickets
    match /support_tickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    // 12. Complaints & Quality Reports
    match /complaints/{complaintId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isStaff();
    }

    // Default Deny All other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
